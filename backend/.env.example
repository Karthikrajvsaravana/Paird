# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Generate a key with:
#   .\backend\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-new-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Optional: separate key for signing JWTs (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Supabase PostgreSQL (Project Settings -> Database -> Connection string)
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-your-database-password
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=True

# Browser origins allowed to call the API (only needed for Flutter web).
# Comma-separated, e.g. http://localhost:5173 — leave empty for mobile-only.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Production HTTPS (only used when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_HTTPS_PROXY=False
DJANGO_HSTS_SECONDS=31536000

# Uploaded photo storage.
#   filesystem = files saved on this computer in MEDIA_ROOT (local testing only)
#   s3         = a PRIVATE Supabase Storage bucket (recommended; nothing on disk)
# Supabase: Storage -> New bucket (Public OFF); Project Settings -> Storage ->
# S3 Connection: copy Endpoint and Region, then "New access key".
# The access keys have full storage access: backend/.env only, never the app.
STORAGE_BACKEND=filesystem
MEDIA_ROOT=
STORAGE_S3_BUCKET=paird-media
STORAGE_S3_ENDPOINT_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=your-project-region
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Email (SMTP) for welcome emails and password reset codes. Without these,
# DEBUG prints emails in the Django console instead of sending them.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True,
# EMAIL_HOST_USER=<your Gmail address>, EMAIL_HOST_PASSWORD=<a Gmail App Password,
# not your normal password>, DEFAULT_FROM_EMAIL=PairD <your Gmail address>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PairD <no-reply@example.com>
EMAIL_TIMEOUT=10
# Welcome email after sign-up with an email address (True/False)
PAIRD_WELCOME_EMAIL_ENABLED=True
# Optional address shown in emails for "I didn't create this account"
PAIRD_SUPPORT_EMAIL=

# Product rules
PAIRD_MIN_AGE=18
PAIRD_INTEREST_EXPIRY_DAYS=7
PAIRD_DECLINE_COOLDOWN_DAYS=30
PAIRD_FREE_DAILY_INTEREST_LIMIT=10
# Optional default country code for phone numbers typed without "+", e.g. +91
PAIRD_DEFAULT_PHONE_COUNTRY_CODE=

# Automated tests ONLY: a dedicated PostgreSQL test database (for example a
# separate Supabase project used just for testing). Never the production DB.
# Django creates and drops a temporary "test_<TEST_DB_NAME>" database there.
TEST_DB_NAME=postgres
TEST_DB_USER=postgres.your-test-project-ref
TEST_DB_PASSWORD=replace-with-your-test-database-password
TEST_DB_HOST=your-test-project-session-pooler-host
TEST_DB_PORT=5432
TEST_DB_SSLMODE=require

# AI match insights (Anthropic Claude). Leave ANTHROPIC_API_KEY empty to keep
# AI off; the rules-based match engine (Vibe Score) always works without it.
# Create a key at https://console.anthropic.com -> API keys. Backend only.
ANTHROPIC_API_KEY=
PAIRD_AI_ENABLED=True
PAIRD_AI_MODEL=claude-opus-5-5
PAIRD_AI_EFFORT=medium
PAIRD_AI_TIMEOUT_SECONDS=60
# New AI insights per member per 24 hours (cached insights don't count)
PAIRD_AI_DAILY_LIMIT=40
