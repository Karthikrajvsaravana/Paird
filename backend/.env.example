# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Generate a key with:
#   .\backend\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-new-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Optional: separate key for signing JWTs (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Supabase PostgreSQL (Project Settings -> Database -> Connection string)
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=replace-with-your-database-password
DB_HOST=your-session-pooler-host
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=True

# Browser origins allowed to call the API (only needed for Flutter web).
# Comma-separated, e.g. http://localhost:5173 — leave empty for mobile-only.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Production HTTPS (only used when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_HTTPS_PROXY=False
DJANGO_HSTS_SECONDS=31536000

# Uploaded photo storage: "filesystem" (MEDIA_ROOT) or "s3" (S3-compatible,
# e.g. Supabase Storage). For s3: pip install "django-storages[s3]" and use a
# PRIVATE bucket.
STORAGE_BACKEND=filesystem
MEDIA_ROOT=
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Email for password reset codes (SMTP). Without these, DEBUG prints emails
# to the console and production returns "not configured".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Paird <no-reply@example.com>

# Product rules
PAIRD_MIN_AGE=18
PAIRD_INTEREST_EXPIRY_DAYS=7
PAIRD_DECLINE_COOLDOWN_DAYS=30
PAIRD_FREE_DAILY_INTEREST_LIMIT=10
# Optional default country code for phone numbers typed without "+", e.g. +91
PAIRD_DEFAULT_PHONE_COUNTRY_CODE=

# Automated tests ONLY: a dedicated PostgreSQL test database (for example a
# separate Supabase project used just for testing). Never the production DB.
# Django creates and drops a temporary "test_<TEST_DB_NAME>" database there.
TEST_DB_NAME=postgres
TEST_DB_USER=postgres.your-test-project-ref
TEST_DB_PASSWORD=replace-with-your-test-database-password
TEST_DB_HOST=your-test-project-session-pooler-host
TEST_DB_PORT=5432
TEST_DB_SSLMODE=require
